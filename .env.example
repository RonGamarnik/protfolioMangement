# Copy this file to .env and fill in private values.

APP_ENV=development
HOST=127.0.0.1
PORT=4173
APP_BASE_URL=http://127.0.0.1:4173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3305
MYSQL_USER=portfolio
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=portfolio_live
MIGRATE_SQLITE=1

# Railway deployment:
# Prefer MYSQL_URL when Railway exposes it, or use MYSQLHOST/MYSQLPORT/
# MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE from the Railway MySQL service.
# Do not use MYSQL_HOST=127.0.0.1 in production.
# MYSQL_URL=mysql://user:password@host:3306/database

PASSWORD_RESET_TOKEN_MINUTES=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=replace_with_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TLS=1
SMTP_SSL=1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
